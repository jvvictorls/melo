generator client {
  provider = "prisma-client"
  output = "../src/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

//enum
enum Role {
  ADMIN
  USER
  SUPERADMIN
}

model User{
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}